{
  "manifest_version": 3,
  "name": "NZ Chrome",
  "version": "0.2.0",
  "description": "Точечный доступ к Gemini, AI Studio, NotebookLM и Google Labs через ваш или локальный прокси — остальной трафик идёт напрямую.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NZ Chrome",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.gemini.google.com/*",
    "https://bard.google.com/*",
    "https://aistudio.google.com/*",
    "https://*.aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "https://*.notebooklm.google.com/*",
    "https://notebooklm.google/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://labs.google.com/*",
    "https://cp.cloudflare.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://notebooklm.google/*",
        "https://labs.google/*",
        "https://labs.google.com/*",
        "https://www.google.com/sorry/*",
        "https://google.com/sorry/*"
      ],
      "js": [
        "src/content/gemini-detector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
